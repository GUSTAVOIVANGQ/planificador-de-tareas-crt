[Unit]
Description=CRT Planificador de tareas (prototipo interno)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crtapp
Group=crtapp
WorkingDirectory=/opt/crt-planificador
ExecStart=/usr/bin/python3.11 -u /opt/crt-planificador/server.py --host 0.0.0.0 --port 8086 --no-browser
Restart=on-failure
RestartSec=5
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/crt-planificador/datos

[Install]
WantedBy=multi-user.target
